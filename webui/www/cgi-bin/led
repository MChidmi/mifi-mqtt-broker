#!/data/local/tmp/webui/busybox sh
# LED test/control. Auth-gated. Only writes /sys/class/leds/<name>/brightness for an
# existing LED, value 0..255 (validated — no arbitrary paths or commands).
BB=/data/local/tmp/webui/busybox
auth=$HTTP_AUTHORIZATION
printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

chk='{"cmdid":"getsysinfo","sessionId":"'"$auth"'"}'
resp=$( { printf 'POST /himiapi/json HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nAuthorization: %s\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s' "$auth" "${#chk}" "$chk"; } | $BB timeout 8 $BB nc 127.0.0.1 8000 2>/dev/null )
case "$resp" in ""|*SessionOut*|*'"reply":"error"'*) echo '{"error":"unauthorized","leds":[]}'; exit 0;; esac

L=/sys/class/leds
if [ "$REQUEST_METHOD" = "POST" ]; then
  len=${CONTENT_LENGTH:-0}; body=$($BB head -c "$len" 2>/dev/null)
  led=$(printf '%s' "$body" | $BB sed -n 's/.*"led"[ :]*"\([A-Za-z0-9_:.-]*\)".*/\1/p')
  val=$(printf '%s' "$body" | $BB grep -oE '"value"[^0-9]*[0-9]+' | $BB grep -oE '[0-9]+$')
  # validate strictly
  case "$led" in *..*|*/*|"") led="";; esac
  [ -n "$led" ] && [ -w "$L/$led/brightness" ] && [ -n "$val" ] && [ "$val" -ge 0 ] 2>/dev/null && [ "$val" -le 255 ] 2>/dev/null && echo "$val" > "$L/$led/brightness" 2>/dev/null
fi

# list all LEDs
printf '{"leds":['
first=1
for d in $L/*; do
  [ -e "$d/brightness" ] || continue
  n=$($BB basename "$d"); br=$(cat "$d/brightness" 2>/dev/null); mx=$(cat "$d/max_brightness" 2>/dev/null)
  [ $first -eq 1 ] || printf ','
  first=0
  printf '{"name":"%s","brightness":%s,"max":%s}' "$n" "${br:-0}" "${mx:-255}"
done
printf ']}'
