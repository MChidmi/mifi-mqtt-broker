#!/data/local/tmp/webui/busybox sh
# Battery charge-limiter control + status. Auth-gated. Only accepts validated integers
# (no arbitrary commands). GET = status; POST {"enabled":0|1,"high":N,"low":N}.
BB=/data/local/tmp/webui/busybox
D=/data/local/tmp/webui
CONF=$D/battd.conf
B=/sys/class/power_supply/battery
auth=$HTTP_AUTHORIZATION

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

chk='{"cmdid":"getsysinfo","sessionId":"'"$auth"'"}'
resp=$( { printf 'POST /himiapi/json HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nAuthorization: %s\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s' "$auth" "${#chk}" "$chk"; } | $BB timeout 8 $BB nc 127.0.0.1 8000 2>/dev/null )
case "$resp" in ""|*SessionOut*|*'"reply":"error"'*) echo '{"error":"unauthorized"}'; exit 0;; esac

ENABLED=0; HIGH=80; LOW=60
[ -f "$CONF" ] && . "$CONF" 2>/dev/null

if [ "$REQUEST_METHOD" = "POST" ]; then
  len=${CONTENT_LENGTH:-0}; body=$($BB head -c "$len" 2>/dev/null)
  en=$(printf '%s' "$body" | $BB grep -oE '"enabled"[^0-9]*[0-9]+' | $BB grep -oE '[0-9]+$')
  hi=$(printf '%s' "$body" | $BB grep -oE '"high"[^0-9]*[0-9]+'    | $BB grep -oE '[0-9]+$')
  lo=$(printf '%s' "$body" | $BB grep -oE '"low"[^0-9]*[0-9]+'     | $BB grep -oE '[0-9]+$')
  [ "$en" = "1" ] || en=0
  [ -n "$hi" ] && [ "$hi" -ge 20 ] 2>/dev/null && [ "$hi" -le 100 ] 2>/dev/null && HIGH=$hi
  [ -n "$lo" ] && [ "$lo" -ge 5 ] 2>/dev/null && [ "$lo" -lt "$HIGH" ] 2>/dev/null && LOW=$lo
  ENABLED=$en
  printf 'ENABLED=%s\nHIGH=%s\nLOW=%s\n' "$ENABLED" "$HIGH" "$LOW" > "$CONF"
  # make sure the daemon is running (detached)
  $BB pgrep -f battd.sh >/dev/null 2>&1 || $BB setsid /system/bin/sh "$D/battd.sh" >/dev/null 2>&1 &
fi

cap=$(cat $B/capacity 2>/dev/null); st=$(cat $B/status 2>/dev/null)
chg=$(cat $B/charging_enabled 2>/dev/null)
run=0; $BB pgrep -f battd.sh >/dev/null 2>&1 && run=1
printf '{"capacity":%s,"status":"%s","charging_enabled":%s,"enabled":%s,"high":%s,"low":%s,"daemon":%s}' \
  "${cap:-null}" "${st:-}" "${chg:-null}" "$ENABLED" "$HIGH" "$LOW" "$run"
