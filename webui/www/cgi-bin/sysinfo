#!/data/local/tmp/webui/busybox sh
# Read-only system diagnostics (fixed commands only, no user input executed).
# Requires a valid modem session.
BB=/data/local/tmp/webui/busybox
export PATH=/data/local/tmp/webui:/system/bin:/system/xbin:$PATH
auth=$HTTP_AUTHORIZATION

printf 'Content-Type: text/plain; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n\r\n'

chk='{"cmdid":"getsysinfo","sessionId":"'"$auth"'"}'
resp=$( { printf 'POST /himiapi/json HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nAuthorization: %s\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s' "$auth" "${#chk}" "$chk"; } | $BB timeout 8 $BB nc 127.0.0.1 8000 2>/dev/null )
case "$resp" in ""|*SessionOut*|*'"reply":"error"'*) echo "Unauthorized — sign in first."; exit 0;; esac

echo "MODEL : $(getprop ro.product.model)  (Android $(getprop ro.build.version.release))"
echo "BUILD : $(getprop ro.build.fingerprint)"
echo "SIM   : $(getprop gsm.sim.state)"
echo "BATT  : $(cat /sys/class/power_supply/battery/capacity 2>/dev/null)%   TEMP $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"
echo
echo "== uptime / load =="; uptime
echo
echo "== memory =="; $BB head -4 /proc/meminfo
echo
echo "== storage =="; $BB df -h /data /system 2>/dev/null
echo
echo "== network interfaces =="; ($BB ip addr 2>/dev/null || $BB ifconfig 2>/dev/null) | $BB grep -E "^[0-9]|inet |wlan|rmnet|usb|HWaddr"
echo
echo "== modem daemons =="; $BB ps 2>/dev/null | $BB grep -E "rild|qmuxd|netmgrd|himiwebserver" | $BB grep -v grep
